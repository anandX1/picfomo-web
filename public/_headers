# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Hero images: long cache since they rarely change
/hero/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400

# Homepage: preload the LCP hero image via early hints
/
  Link: </hero/1.webp>; rel=preload; as=image; type=image/webp
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
